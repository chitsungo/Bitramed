{
  "name": "bitramed",
  "version": "3.1.0",
  "private": true,
  "description": "quiz app",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && powershell -ExecutionPolicy Bypass -File scripts/prepare-public-deploy.ps1",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "build:css": "tailwindcss -i ./src/styles/tw-input.css -o ./src/styles/tailwind.css",
    "watch:css": "tailwindcss -i ./src/styles/tw-input.css -o ./src/styles/tailwind.css --watch",
    "lint:js": "eslint src tests --ext .js,.jsx",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "format": "prettier --write \"**/*.{js,jsx,json,css,html,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,html,mjs}\"",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.25.1",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "vite": "^8.0.16"
  }
}
