{
  "name": "bitramed",
  "version": "3.1.0",
  "private": true,
  "description": "Bitramed medical revision platform",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm --workspace @bitramed/web run dev",
    "build": "npm --workspace @bitramed/web run build",
    "start": "http-server apps/web/out -a 0.0.0.0 -p 3000 -c-1",
    "test": "npm --workspace @bitramed/web run test",
    "test:unit": "npm --workspace @bitramed/web run test",
    "lint": "npm --workspace @bitramed/web run lint",
    "typecheck": "npm --workspace @bitramed/web run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,html,mjs,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,html,mjs,md}\"",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.69.0"
  }
}
